---
/**
 * Figure 2: section through the structure.
 *
 * Every course, annotation and level is present in the served markup, so the
 * drawing is complete with JavaScript disabled. The scroll controller only adds
 * a datum cursor that tracks the level being read; nothing is hidden, dimmed or
 * revealed, so no fact depends on scripting and no text loses contrast.
 */
---

<svg
  class="ascent-figure"
  data-ascent-figure
  viewBox="0 0 480 720"
  role="img"
  aria-labelledby="ascent-fig-title ascent-fig-desc"
>
  <title id="ascent-fig-title">Section through the Ziggurat admission structure</title>
  <desc id="ascent-fig-desc">
    A stepped section drawn from bottom to top. An untrusted capture enters at ground
    level and becomes a Bronze course of preserved evidence. A narrower Silver course of
    staged proposals sits above it. Above Silver the structure stops: a recessed gap
    separates it from the Gold course, and the only line crossing that gap enters
    horizontally from outside the plate, representing an external Ed25519 key. A block
    labelled reviewed_by colon alice sits inside the gap carrying a refused stamp. The
    Gold course sits above the gap, and a narrow aperture at the summit emits a single
    read-only arrow. The seven levels are annotated in the numbered list beside this
    figure.
  </desc>

  <!-- Datum rail and plate frame -->
  <g class="fig-hair" stroke-width="1">
    <path d="M44 36V700" />
    <path d="M428 36V700" />
  </g>
  <path class="fig-rule" stroke-width="1.5" d="M44 690H428" />

  <!-- Recessed authorization gap, centered on the tiers' x=236 axis -->
  <rect x="86" y="186" width="300" height="108" fill="var(--zg-ground)"></rect>
  <g class="fig-rule" stroke-width="1.5" stroke-dasharray="7 6">
    <path d="M86 186H386" />
    <path d="M86 294H386" />
  </g>

  <!-- Datum cursor: the single authored motion, added only by the controller -->
  <g class="datum-cursor" aria-hidden="true">
    <path d="M36 -6L48 0L36 6Z" class="fill-ink"></path>
    <path d="M52 0H428" stroke="var(--zg-ink)" stroke-width="1" stroke-dasharray="3 4"></path>
  </g>

  <!-- Level 00: untrusted capture -->
  <g class="lvl" data-lvl="0">
    <text class="fig-label--datum" x="30" y="609" text-anchor="end">00</text>
    <path class="fig-rule" stroke-width="1.5" d="M36 604H52" />
    <rect class="focus-ring" x="150" y="554" width="172" height="100"></rect>
    <rect x="156" y="560" width="160" height="88" fill="none" stroke="var(--zg-rule-strong)" stroke-width="1.5"></rect>
    <g class="fig-hair" stroke-width="1.5">
      <path d="M172 584H300" />
      <path d="M172 600H300" />
      <path d="M172 616H268" />
      <path d="M172 632H284" />
    </g>
    <text class="fig-label--small" x="156" y="672">untrusted capture</text>
    <path class="fig-stroke-ink" stroke-width="1.5" d="M236 558V494" />
    <path class="fig-ink" d="M231 494h10l-5-8Z"></path>
    <text class="fig-label--small" x="248" y="528">ingest</text>
  </g>

  <!-- Level 01: Bronze -->
  <g class="lvl" data-lvl="1">
    <text class="fig-label--datum" x="30" y="461" text-anchor="end">01</text>
    <path class="fig-rule" stroke-width="1.5" d="M36 456H52" />
    <rect class="focus-ring" x="100" y="424" width="272" height="64"></rect>
    <rect x="106" y="430" width="260" height="52" fill="var(--zg-bronze-solid)"></rect>
    <text class="fig-label fill-on-bronze" x="118" y="462"  font-weight="600">BRONZE</text>
    <text class="fig-label fill-on-bronze" x="354" y="462"  text-anchor="end">preserved</text>
    <path class="fig-stroke-ink" stroke-width="1.5" d="M236 428V378" />
    <path class="fig-ink" d="M231 378h10l-5-8Z"></path>
    <text class="fig-label--small" x="248" y="406">refine</text>
  </g>

  <!-- Level 02: Silver, and the end of model reach -->
  <g class="lvl" data-lvl="2">
    <text class="fig-label--datum" x="30" y="345" text-anchor="end">02</text>
    <path class="fig-rule" stroke-width="1.5" d="M36 340H52" />
    <rect class="focus-ring" x="132" y="308" width="208" height="64"></rect>
    <rect x="138" y="314" width="196" height="52" fill="var(--zg-silver-solid)"></rect>
    <text class="fig-label fill-on-silver" x="150" y="346"  font-weight="600">SILVER</text>
    <text class="fig-label fill-on-silver" x="322" y="346"  text-anchor="end">proposed</text>
    <path class="fig-stroke-ink" stroke-width="4" d="M206 294H266" />
    <text class="fig-label--small" x="274" y="306">model reach ends</text>
  </g>

  <!-- Level 03: a self-asserted marker is refused -->
  <g class="lvl" data-lvl="3">
    <text class="fig-label--datum" x="30" y="268" text-anchor="end">03</text>
    <path class="fig-rule" stroke-width="1.5" d="M36 263H52" />
    <rect class="focus-ring" x="99" y="242" width="274" height="42"></rect>
    <rect x="105" y="248" width="160" height="30" fill="none" stroke="var(--zg-refuse)" stroke-width="1.5" stroke-dasharray="5 4"></rect>
    <text class="fig-label--small fill-refuse" x="113" y="268" >reviewed_by: alice</text>
    <path d="M265 263H273" stroke="var(--zg-refuse)" stroke-width="1.5"></path>
    <rect x="273" y="248" width="94" height="30" fill="none" stroke="var(--zg-refuse)" stroke-width="2"></rect>
    <text class="fig-label--small fill-refuse" x="320" y="268" text-anchor="middle" font-weight="700">REFUSED</text>
  </g>

  <!-- Level 04: the external signing capability -->
  <g class="lvl" data-lvl="4">
    <text class="fig-label--datum" x="30" y="219" text-anchor="end">04</text>
    <path class="fig-rule" stroke-width="1.5" d="M36 214H52" />
    <rect class="focus-ring" x="218" y="187" width="180" height="55"></rect>
    <path d="M470 214H247" stroke="var(--zg-gold)" stroke-width="3"></path>
    <circle cx="236" cy="214" r="11" fill="none" stroke="var(--zg-gold)" stroke-width="3"></circle>
    <text class="fig-label--small fill-gold" x="262" y="206" >external key</text>
    <text class="fig-label--small fill-ink-3" x="262" y="236" >outside the vault</text>
  </g>

  <!-- Level 05: Gold -->
  <g class="lvl" data-lvl="5">
    <text class="fig-label--datum" x="30" y="157" text-anchor="end">05</text>
    <path class="fig-rule" stroke-width="1.5" d="M36 152H52" />
    <rect class="focus-ring" x="164" y="120" width="144" height="64"></rect>
    <rect x="170" y="126" width="132" height="52" fill="var(--zg-gold-solid)"></rect>
    <text class="fig-label fill-on-gold" x="182" y="158"  font-weight="600">GOLD</text>
    <text class="fig-label--small fill-ink-2" x="314" y="158" >authorized</text>
    <path class="fig-stroke-ink" stroke-width="1.5" d="M236 124V84" />
    <path class="fig-ink" d="M231 84h10l-5-8Z"></path>
  </g>

  <!-- Level 06: Gold aperture -->
  <g class="lvl" data-lvl="6">
    <text class="fig-label--datum" x="30" y="67" text-anchor="end">06</text>
    <path class="fig-rule" stroke-width="1.5" d="M36 62H52" />
    <rect class="focus-ring" x="206" y="46" width="60" height="32"></rect>
    <rect x="212" y="52" width="48" height="20" fill="var(--zg-ink)"></rect>
    <path class="fig-stroke-ink" stroke-width="1.5" d="M266 62H334" />
    <path class="fig-ink" d="M334 57v10l8-5Z"></path>
    <text class="fig-label--small" x="348" y="66">read only</text>
  </g>
</svg>

<style>
  .ascent-figure {
    width: 100%;
    height: auto;
  }

  /*
    Scoped fills. A class in home.css sets `fill` on .fig-label, and a CSS rule beats an
    SVG presentation attribute at any specificity, so tier labels have to be coloured by
    a rule rather than by fill="...".
  */
  .fill-on-bronze {
    fill: var(--zg-on-bronze);
  }

  .fill-on-silver {
    fill: var(--zg-on-silver);
  }

  .fill-on-gold {
    fill: var(--zg-on-gold);
  }

  .fill-refuse {
    fill: var(--zg-refuse);
  }

  .fill-ink {
    fill: var(--zg-ink);
  }

  .fill-gold {
    fill: var(--zg-gold);
  }

  .fill-ink-2 {
    fill: var(--zg-ink-2);
  }

  .fill-ink-3 {
    fill: var(--zg-ink-3);
  }

  /* Additive emphasis only: nothing is dimmed, so every label keeps its contrast. */
  .focus-ring {
    fill: none;
    stroke: var(--zg-ink);
    stroke-width: 1.5;
    opacity: 0;
  }

  .datum-cursor {
    opacity: 0;
    transform: translateY(0);
  }

  .ascent-figure[data-active] .datum-cursor {
    opacity: 1;
    transform: translateY(var(--cursor-y, 0px));
    transition:
      transform 620ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 260ms linear;
  }

  .ascent-figure[data-active] .lvl.is-active .focus-ring {
    opacity: 1;
    transition: opacity 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .datum-cursor,
    .ascent-figure[data-active] .datum-cursor {
      opacity: 0;
      transform: none;
      transition: none;
    }

    .ascent-figure[data-active] .lvl.is-active .focus-ring {
      transition: none;
    }
  }
</style>
