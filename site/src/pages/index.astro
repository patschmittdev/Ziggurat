    <script>
      /**
       * Ascent controller.
       *
       * Adds a datum cursor that tracks the level being read. It is enabled only on wide
       * viewports, where the section is sticky, and never when reduced motion is requested.
       * It adds emphasis and removes nothing, so every fact stays legible in every state.
       */
      const figure = document.querySelector<SVGSVGElement>('[data-ascent-figure]');
      const steps = Array.from(document.querySelectorAll<HTMLElement>('.step[data-cursor]'));

      if (figure && steps.length > 0) {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        const wide = window.matchMedia('(min-width: 64rem)');
        let observer: IntersectionObserver | null = null;

        const clear = () => {
          for (const step of steps) {
            const level = step.dataset.level;
            figure.querySelector(`.lvl[data-lvl="${Number(level)}"]`)?.classList.remove('is-active');
          }
          for (const group of figure.querySelectorAll('.lvl')) group.classList.remove('is-active');
          figure.removeAttribute('data-active');
          figure.style.removeProperty('--cursor-y');
        };

        const activate = (step: HTMLElement) => {
          const index = steps.indexOf(step);
          if (index < 0) return;
          for (const group of figure.querySelectorAll('.lvl')) group.classList.remove('is-active');
          figure.querySelector(`.lvl[data-lvl="${index}"]`)?.classList.add('is-active');
          figure.style.setProperty('--cursor-y', `${step.dataset.cursor ?? 0}px`);
          figure.setAttribute('data-active', '');
        };

        const disconnect = () => {
          observer?.disconnect();
          observer = null;
          clear();
        };

        const connect = () => {
          if (observer) return;
          observer = new IntersectionObserver(
            (entries) => {
              const visible = entries
                .filter((entry) => entry.isIntersecting)
                .map((entry) => entry.target as HTMLElement);
              if (visible.length > 0) {
                visible.sort((a, b) => steps.indexOf(a) - steps.indexOf(b));
                const first = visible[0];
                if (first) activate(first);
              }
            },
            { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
          );
          for (const step of steps) observer.observe(step);
        };

        const sync = () => {
          if (reduced.matches || !wide.matches) disconnect();
          else connect();
        };

        reduced.addEventListener('change', sync);
        wide.addEventListener('change', sync);
        sync();
      }

      /**
       * Section-entry reveals.
       *
       * Hidden initial states exist only under html[data-js-ready], which is set
       * here and nowhere else, so a visitor without scripting always sees the
       * complete page. Groups reveal once and are then unobserved. Reduced
       * motion is handled entirely in motion.css: everything renders immediately.
       */
      {
        const root = document.documentElement;
        const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
        if (groups.length > 0 && 'IntersectionObserver' in window) {
          // Engage hidden initial states only once a live render loop is proven,
          // so prerenderers, hidden iframes, and print pipelines render the
          // complete page statically.
          requestAnimationFrame(() => {
            root.setAttribute('data-js-ready', '');
            const io = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-in');
                    io.unobserve(entry.target);
                  }
                }
              },
              { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
            );
            for (const group of groups) io.observe(group);
          });
        }
      }
    </script>
