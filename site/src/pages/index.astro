    <script>
      /**
       * Ascent controller.
       *
       * Marks the level being read with a datum cursor and an additive focus ring. It
       * adds emphasis and removes nothing, so every fact stays legible in every state.
       *
       * Enabled only at or above 64rem, where the plate is sticky and a reading cursor
       * has something to track. Reduced motion keeps the controller running and lets
       * the stylesheet drop the interpolation, so the information survives while the
       * movement does not.
       */
      const figure = document.querySelector<SVGSVGElement>('[data-ascent-figure]');
      const steps = Array.from(document.querySelectorAll<HTMLElement>('.step[data-cursor]'));

      if (figure && steps.length > 0) {
        const wide = window.matchMedia('(min-width: 64rem)');
        // Level groups are resolved once. The observer callback never queries the DOM.
        const levels = steps.map((_, index) =>
          figure.querySelector<SVGGElement>(`.lvl[data-lvl="${index}"]`),
        );

        const visible = new Set<HTMLElement>();
        let observer: IntersectionObserver | null = null;
        let frame = 0;
        let arming = false;
        let painted: number | null = null;
        let wanted: number | null = null;

        const paint = (index: number) => {
          for (let i = 0; i < levels.length; i += 1) {
            levels[i]?.classList.toggle('is-active', i === index);
          }
          figure.style.setProperty('--cursor-y', `${steps[index]?.dataset.cursor ?? 0}px`);
          painted = index;
        };

        const disarm = () => {
          for (const level of levels) level?.classList.remove('is-active');
          figure.removeAttribute('data-active');
          figure.style.removeProperty('--cursor-y');
          painted = null;
        };

        /** Single coalesced write per frame. No layout is read here or anywhere else. */
        const flush = () => {
          frame = 0;

          if (wanted === null) {
            if (painted !== null) disarm();
            return;
          }

          if (wanted !== painted) paint(wanted);

          /*
            Arm the transition one frame after a position exists, so the cursor's
            first appearance is a fade at the right level rather than a traverse
            from the top of the plate.

            Armed state is read from the attribute rather than inferred from a
            previous paint, and the deferred callback commits whatever level is
            current when it runs. A target that changes between the position write
            and the frame is therefore still armed, and the arming is idempotent:
            a queued frame is never duplicated and never lost.
          */
          if (!figure.hasAttribute('data-active') && !arming) {
            arming = true;
            requestAnimationFrame(() => {
              arming = false;
              if (wanted === null) return;
              if (wanted !== painted) paint(wanted);
              figure.setAttribute('data-active', '');
            });
          }
        };

        const schedule = (next: number | null) => {
          wanted = next;
          if (frame === 0) frame = requestAnimationFrame(flush);
        };

        /** The topmost step still crossing the reading band, or nothing. */
        const resolve = () => {
          let best: number | null = null;
          for (const step of visible) {
            const index = steps.indexOf(step);
            if (index >= 0 && (best === null || index < best)) best = index;
          }
          schedule(best);
        };

        const disconnect = () => {
          observer?.disconnect();
          observer = null;
          visible.clear();
          schedule(null);
        };

        const connect = () => {
          if (observer) return;
          observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                const step = entry.target as HTMLElement;
                if (entry.isIntersecting) visible.add(step);
                else visible.delete(step);
              }
              resolve();
            },
            { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
          );
          for (const step of steps) observer.observe(step);
        };

        const sync = () => {
          if (wide.matches) connect();
          else disconnect();
        };

        wide.addEventListener('change', sync);
        sync();
      }

      /**
       * Section-entry reveals.
       *
       * Orientation only. Hidden states are established synchronously in the head and
       * released by MotionScript if this controller never reports in, so no fact can
       * be stranded by a script that fails to run.
       *
       * `data-reveal` carries the group's place in the entry rhythm, 1 to 3, which the
       * stylesheet turns into a 0ms, 90ms, or 180ms delay. Each group reveals once on
       * its own entry and is then unobserved.
       */
      {
        const ready = (window as unknown as { __zgMotionReady?: (ok: boolean) => void })
          .__zgMotionReady;

        if (!('IntersectionObserver' in window)) {
          ready?.(false);
        } else {
          const targets = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

          if (targets.length === 0) {
            ready?.(false);
          } else {
            const STAGGER_CAP = 2;

            const reveal = (target: HTMLElement) => {
              const place = Number(target.dataset.reveal);
              const step = Number.isFinite(place) ? Math.min(Math.max(place - 1, 0), STAGGER_CAP) : 0;
              target.style.setProperty('--zg-i', `${step}`);
              target.classList.add('is-in');
            };

            const observer = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (!entry.isIntersecting) continue;
                  reveal(entry.target as HTMLElement);
                  observer.unobserve(entry.target);
                }
              },
              // The top margin is deliberately unbounded: anything already above the
              // viewport counts as entered, so a deep link, a restored scroll position,
              // or a jump to an anchor never leaves an upstream group hidden.
              { rootMargin: '100000px 0px -8% 0px', threshold: 0 },
            );

            for (const target of targets) observer.observe(target);
            ready?.(true);
          }
        }
      }
    </script>
