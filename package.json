{
  "name": "ziggurat",
  "version": "0.1.0",
  "description": "A human-gated memory firewall for evidence-backed AI context.",
  "private": true,
  "license": "MIT",
  "repository": "github:patschmittdev/Ziggurat",
  "homepage": "https://github.com/patschmittdev/Ziggurat#readme",
  "bugs": {
    "url": "https://github.com/patschmittdev/Ziggurat/issues"
  },
  "keywords": [
    "ai-memory",
    "context-poisoning",
    "human-in-the-loop",
    "mcp",
    "retrieval"
  ],
  "type": "module",
  "bin": { "ziggurat": "./dist/src/cli/main.js" },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "test": "npm run clean && npm run build && node --test \"dist/test/*.test.js\"",
    "check": "npm run test",
    "prepublishOnly": "npm run check"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.0.0",
    "typescript": "^7.0.0"
  }
}
